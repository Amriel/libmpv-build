From 43511bee0658cd87d98ba180ca5147698b808719 Mon Sep 17 00:00:00 2001
From: libmpv-build <libmpv-build@users.noreply.github.com>
Date: Mon, 5 Oct 2026 01:39:11 +0300
Subject: [PATCH] api: add missing <exception> include for libc++ 23

Backport of upstream zimg commit 67e0603271c0 ("Add missing includes for libcxx-23") to release-3.0.6: zimg.cpp uses std::exception_ptr / std::current_exception, which libc++ 23 no longer declares transitively.
---
 src/zimg/api/zimg.cpp | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/zimg/api/zimg.cpp b/src/zimg/api/zimg.cpp
index 90eb082..1a63bc0 100644
--- a/src/zimg/api/zimg.cpp
+++ b/src/zimg/api/zimg.cpp
@@ -1,4 +1,5 @@
 #include <cmath>
+#include <exception>
 #include <memory>
 #include <string>
 #include <tuple>
-- 
2.55.0.windows.3

